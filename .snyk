        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-URIJS-19963961':
    - '* > uri-js@4.4.1':
        reason: 'No fixed version available. Transitive dependency of Docusaurus (apps/docs, build-time only); not shipped to the production runtime.'
