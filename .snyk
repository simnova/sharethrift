version: v1.5.0
# Prefer pnpm overrides (pnpm-workspace.yaml) over ignores; only issues with no viable fix belong here.
ignore:
  'SNYK-JS-BRACES-19963945':
    - '* > braces@3.0.3':
        reason: 'No fixed version available. Transitive via micromatch in graphql-tools file loaders, Serenity/Cucumber and Docusaurus; glob patterns are static repo paths, not user input.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-DEEPMERGE-19964053':
    - '* > deepmerge@4.3.1':
        reason: 'No fixed version available. Transitive via @sendgrid/mail and Docusaurus; merged objects are constructed by application code, not parsed from untrusted input.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-GRAYMATTER-20532010':
    - '* > gray-matter@4.0.3':
        reason: 'No fixed version available. Transitive dependency of Docusaurus (apps/docs, build-time only); not shipped to the production runtime. Front matter comes from repo-authored markdown.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-HTTPCACHESEMANTICS-19964064':
    - '* > http-cache-semantics@4.2.0':
        reason: 'No fixed version available. Transitive dependency of Docusaurus (apps/docs, build-time only); not shipped to the production runtime.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-HTTPCACHESEMANTICS-19964068':
    - '* > http-cache-semantics@4.2.0':
        reason: 'No fixed version available. Transitive dependency of Docusaurus (apps/docs, build-time only); not shipped to the production runtime.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-MONGOOSE-16425765':
    - '* > mongoose@8.17.0':
        reason: 'Fix requires mongoose 8.22+/8.24+, whose lean() return-type changes break persistence-layer read repositories; upgrade deferred to a dedicated effort. Query inputs are validated by the domain layer.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-MONGOOSE-18319533':
    - '* > mongoose@8.17.0':
        reason: 'Fix requires mongoose 8.22+/8.24+, whose lean() return-type changes break persistence-layer read repositories; upgrade deferred to a dedicated effort. Query inputs are validated by the domain layer.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-NODEFORGE-19635204':
    - '* > node-forge@1.4.0':
        reason: 'No fixed version available. Transitive via cybersource-rest-client; signatures verified are from the CyberSource API over TLS.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-OPENTELEMETRYCORE-17373280':
    - '* > @opentelemetry/core':
        reason: 'Transitive dependency of the OpenTelemetry SDK; fix requires a major-version upgrade of the whole otel suite (deferred). Telemetry payloads are internal, not user-controlled.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-OPENTELEMETRYEXPORTERPROMETHEUS-16758050':
    - '* > @opentelemetry/exporter-prometheus@0.57.2':
        reason: 'Transitive dependency of the OpenTelemetry SDK; fix requires a major-version upgrade of the whole otel suite (deferred). Telemetry payloads are internal, not user-controlled.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-OPENTELEMETRYPROPAGATORJAEGER-17901201':
    - '* > @opentelemetry/propagator-jaeger@1.30.1':
        reason: 'Transitive dependency of the OpenTelemetry SDK; fix requires a major-version upgrade of the whole otel suite (deferred). Telemetry payloads are internal, not user-controlled.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-POSTCSSSELECTORPARSER-20510276':
    - '* > postcss-selector-parser@6.1.4':
        reason: 'Fix only available in 7.x, which the Docusaurus CSS toolchain does not support. Transitive dependency of Docusaurus (apps/docs, build-time only); not shipped to the production runtime.'
        expires: '2027-01-13T00:00:00.000Z'
        created: '2026-10-13T00:00:00.000Z'
  'SNYK-JS-SIRV-12558119':
    - '* > sirv@2.0.4':
        reason: 'Fix only available in 3.x, which webpack-bundle-analyzer does not support. Transitive dependency of Docusaurus (apps/docs, build-time only); not shipped to the production runtime.'
