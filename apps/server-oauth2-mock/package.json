{
	"name": "@apps/server-oauth2-mock",
	"version": "1.0.0",
	"author": "",
	"license": "MIT",
	"description": "Local OAuth2/OIDC mock server for dev/testing",
	"type": "module",
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"scripts": {
		"prebuild": "biome lint",
		"build": "tsgo --build",
		"clean": "rimraf dist node_modules tsconfig.tsbuildinfo && tsgo --build --clean",
		"lint": "biome lint",
		"format": "biome format --write",
		"start": "node dist/src/index.js",
		"dev": "portless mock-auth.sharethrift.localhost tsx src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@cellix/server-oauth2-seedwork": "workspace:*",
		"dotenv": "^16.4.5",
		"express": "^4.22.1",
		"express-rate-limit": "^7.5.0",
		"jose": "^5.9.6"
	},
	"devDependencies": {
		"@cellix/typescript-config": "workspace:*",
		"@cellix/vitest-config": "workspace:*",
		"@types/express": "^4.17.23",
		"rimraf": "^6.0.1",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vitest": "catalog:"
	}
}
