{
	"name": "@apps/ui-admin",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"start": "vite",
		"dev": "PORTLESS_PORT=1355 PORTLESS_STATE_DIR=${HOME}/.portless portless admin.sharethrift.localhost vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"tswatch": "tsc --build --watch",
		"storybook": "PORTLESS_PORT=1355 PORTLESS_STATE_DIR=${HOME}/.portless portless storybook-admin.sharethrift.localhost storybook dev --no-open",
		"build-storybook": "storybook build",
		"test": "echo 'UI Storybook tests disabled (memory constraints)'",
		"test:arch": "vitest run --config vitest.arch.config.ts",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ant-design/icons": "^6.1.0",
		"@ant-design/v5-patch-for-react-19": "^1.0.3",
		"@apollo/client": "^4.0.7",
		"@sthrift/ui-components": "workspace:*",
		"antd": "^5.27.1",
		"crypto-hash": "^3.1.0",
		"dayjs": "^1.11.18",
		"graphql": "^16.11.0",
		"lodash": "^4.17.23",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-oidc-context": "^3.3.0",
		"react-router-dom": "^7.12.0",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@cellix/arch-unit-tests": "workspace:*",
		"@cellix/typescript-config": "workspace:*",
		"@cellix/vitest-config": "workspace:*",
		"@eslint/js": "^9.30.1",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@types/lodash": "^4.17.20",
		"@types/react": "^19.1.9",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "^9.30.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.35.1",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"license": "MIT"
}
