{
	"name": "@cellix/service-otel",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		}
	},
	"scripts": {
		"prebuild": "biome lint",
		"build": "tsgo --build",
		"watch": "tsgo --watch",
		"test": "vitest run",
		"test:coverage:node": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "biome lint",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@azure/functions-opentelemetry-instrumentation": "0.3.0",
		"@azure/monitor-opentelemetry-exporter": "1.0.0-beta.32",
		"@cellix/api-services-spec": "workspace:*",
		"@opentelemetry/api": "1.9.0",
		"@opentelemetry/instrumentation-dataloader": "0.40.0",
		"@opentelemetry/instrumentation-graphql": "0.71.0",
		"@opentelemetry/instrumentation-http": "0.223.0",
		"@opentelemetry/instrumentation-mongoose": "0.69.0",
		"@opentelemetry/sdk-logs": "0.223.0",
		"@opentelemetry/sdk-metrics": "2.12.0",
		"@opentelemetry/sdk-node": "0.223.0",
		"@opentelemetry/sdk-trace-node": "2.12.0",
		"@opentelemetry/semantic-conventions": "1.43.0"
	},
	"devDependencies": {
		"@cellix/typescript-config": "workspace:*",
		"@cellix/vitest-config": "workspace:*",
		"rimraf": "^6.0.1",
		"typescript": "^5.8.3"
	},
	"license": "MIT"
}
