{
	"extends": "@cellix/typescript-config/node.json",
	"compilerOptions": {
		"erasableSyntaxOnly": false,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"rootDir": "src",
		"outDir": "dist",
		"tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}
