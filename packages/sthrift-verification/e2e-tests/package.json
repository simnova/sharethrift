{
	"name": "@sthrift-verification/e2e-tests",
	"version": "1.0.0",
	"description": "Cucumber Screenplay E2E tests for ShareThrift (Playwright browser tests)",
	"private": true,
	"type": "module",
	"scripts": {
		"test:e2e": "pnpm run proxy:start && pnpm run test:e2e:run",
		"test:e2e:ci": "pnpm run proxy:start && pnpm run test:e2e:run",
		"test:e2e:run": "NODE_EXTRA_CA_CERTS=${HOME}/.portless/ca.pem LOG_LEVEL=warn NODE_OPTIONS='--import tsx/esm' cucumber-js",
		"proxy:start": "pnpm exec portless proxy start -p 1355",
		"playwright:install": "playwright install chromium",
		"clean": "rimraf dist reports target"
	},
	"dependencies": {
		"@cellix/serenity-framework": "workspace:*",
		"@cucumber/cucumber": "12.8.1",
		"@serenity-js/assertions": "3.43.0",
		"@serenity-js/console-reporter": "3.43.0",
		"@serenity-js/core": "3.43.0",
		"@serenity-js/cucumber": "3.43.0",
		"@serenity-js/serenity-bdd": "3.43.0",
		"std-env": "^4.0.0"
	},
	"devDependencies": {
		"@cellix/typescript-config": "workspace:*",
		"@cucumber/messages": "^32.2.0",
		"@playwright/test": "^1.52.0",
		"playwright": "^1.52.0",
		"@sthrift-verification/verification-shared": "workspace:*",
		"@types/node": "^24.6.1",
		"rimraf": "^6.0.1",
		"tsx": "^4.20.3",
		"typescript": "^5.4.5"
	}
}
